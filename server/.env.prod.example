# Copy to .env.prod on the server (chmod 600). Never commit the real one.

# Origins allowed to post. "null" is the page opened from a USB stick (file://).
ALLOWED_ORIGINS=https://gifting-selector.gpspromotions.com,null

# Airtable mirror. Leave AIRTABLE_PAT empty and rows still land in SQLite; they
# sync to Airtable automatically once a token is set and the container recreated.
# Runtime scope needed: data.records:write on this base only.
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Responses
